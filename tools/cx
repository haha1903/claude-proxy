#!/usr/bin/env python3
"""Choose the default Codex provider and Copilot proxy account."""

import copy
import json
import os
import re
import sys
import tempfile
import time
import tomllib
from pathlib import Path

USAGE = """Usage: cx [official|copilot<N>|status]
Reads providers directly from ~/.codex/config.toml.
Only switches model_provider. Provider addresses, keys, and other settings stay unchanged.
"""


class ConfigError(Exception):
    pass


def discover(config):
    providers = config.get("model_providers", {})
    if not isinstance(providers, dict):
        raise ConfigError("model_providers must be a table in config.toml.")
    names = sorted((name for name in providers if re.fullmatch(r"copilot[1-9][0-9]*", name)),
                   key=lambda name: int(name[7:]))
    return {name: providers[name].get("name", "Copilot " + name[7:]) for name in names
            if isinstance(providers[name], dict)}


def show_status(config):
    providers = config.get("model_providers", {})
    entry = providers.get(config.get("model_provider", "openai"), {}) if isinstance(providers, dict) else {}
    if not isinstance(entry, dict):
        entry = {}
    label = entry.get("name", config.get("model_provider", "openai"))
    print("Provider:", config.get("model_provider", "openai"))
    print("Model:", config.get("model", "(default)"))
    print("Configured proxy:", label)
    print("App provider name:", entry.get("name", "(not configured)"))


def choose_mode(config):
    show_status(config)
    proxies = discover(config)
    choices = {"0": None, "": None, "1": "official"}
    print("\n1) Official OpenAI")
    for index, (provider, label) in enumerate(proxies.items(), 2):
        print(f"{index}) {label}")
        choices[str(index)] = provider
    last = str(len(proxies) + 2)
    print(f"{last}) Status\n0) Cancel")
    choices[last] = "status"
    while True:
        answer = input(f"Select [0-{last}]: ").strip()
        if answer in choices:
            return choices[answer]
        print("Enter " + ", ".join(str(i) for i in range(int(last))) + " or " + last + ".")


def replace_setting(source, key, value):
    pattern = rf"(?m)^[ \t]*{re.escape(key)}[ \t]*=.*$"
    replacement = f"{key} = {json.dumps(value, ensure_ascii=False)}"
    if re.search(pattern, source):
        return re.sub(pattern, lambda _: replacement, source)
    return replacement + "\n" + source


def switch_config(path, original, config, provider):
    if provider != "openai":
        if provider not in discover(config) or not config["model_providers"][provider].get("base_url"):
            raise ConfigError(f"Missing {provider} provider configuration in config.toml.")
    source = original.decode()
    first_table = re.search(r"(?m)^[ \t]*\[", source)
    end = first_table.start() if first_table else len(source)
    root, tables = source[:end], source[end:]
    expected = copy.deepcopy(config)
    root = replace_setting(root, "model_provider", provider)
    expected["model_provider"] = provider

    updated = (root + tables).encode()
    try:
        valid = tomllib.loads(updated.decode()) == expected
    except ValueError:
        valid = False
    if not valid:
        raise ConfigError("Validation failed: unrelated configuration would change.")
    if updated == original:
        print(f"Already using {provider}.")
        return
    if path.read_bytes() != original:
        raise ConfigError("Codex configuration changed while selecting. Run cx again.")

    backup = path.with_name(f"config.toml.backup-{time.time_ns()}")
    fd = os.open(backup, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as handle:
        handle.write(original)
    fd, temporary = tempfile.mkstemp(prefix=".config-switch-", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(updated)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    if tomllib.loads(path.read_text()) != expected:
        raise ConfigError("Configuration readback did not match the selected settings.")
    print(f"Switched to {provider}.")
    print(f"Backup: {backup}")
    print("Restart Codex and start a new chat to use these defaults.")
    print("Provider addresses, keys, and model settings were preserved.")


def main(args=None):
    args = sys.argv[1:] if args is None else args
    if args in (["-h"], ["--help"]):
        print(USAGE, end="")
        return 0
    args = ["copilot" + arg[5:] if re.fullmatch(r"proxy[1-9][0-9]*", arg) else arg for arg in args]
    valid = lambda value: value in {"official", "copilot", "status"} or re.fullmatch(r"copilot[1-9][0-9]*", value)
    if args and not (len(args) == 1 and valid(args[0])
                     or len(args) == 2 and args[0] == "copilot" and re.fullmatch(r"copilot[1-9][0-9]*", args[1])):
        print(USAGE, file=sys.stderr, end="")
        return 2
    path = Path.home() / ".codex/config.toml"
    try:
        original = path.read_bytes()
        config = tomllib.loads(original.decode())
    except (OSError, ValueError):
        print(f"Cannot read Codex configuration: {path}", file=sys.stderr)
        return 1
    try:
        if not args:
            if not sys.stdin.isatty():
                show_status(config)
                print("Run cx in a terminal for the menu, or use cx copilot<N>.")
                return 0
            mode = choose_mode(config)
            if mode is None:
                print("Cancelled. Configuration unchanged.")
                return 0
        else:
            mode = args[-1]
        if mode == "copilot":
            mode = "copilot1"
        if mode == "status":
            show_status(config)
            print("These are defaults; existing chats may keep their previous provider and account history.")
        else:
            switch_config(path, original, config, "openai" if mode == "official" else mode)
        return 0
    except (EOFError, KeyboardInterrupt):
        print("\nCancelled. Configuration unchanged.")
        return 0
    except ConfigError as error:
        print(str(error), file=sys.stderr)
        return 1
    except OSError as error:
        print(f"Cannot update Codex configuration ({type(error).__name__}).", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
